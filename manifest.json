{
  "manifest_version": 3,
  "name": "LEARN Deadline Tracker",
  "version": "0.1.0",
  "description": "Tracks assignment and quiz deadlines from UWaterloo LEARN (D2L Brightspace) and reminds you before they're due.",
  "permissions": ["storage", "alarms", "notifications", "scripting"],
  "host_permissions": [
    "*://*.learn.uwaterloo.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.learn.uwaterloo.ca/d2l/le/calendar/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LEARN Deadline Tracker",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
